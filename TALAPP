# Reglas del negocio
COSTO_ENVIO = 9000
ENVIO_GRATIS_DESDE = 250000
STOCK_MINIMO = 5                 # alerta de inventario bajo

# Listas que se llenan mientras la tienda funciona
carrito = []
ventas = []

print("Datos cargados:", len(productos), "productos en el catálogo.")

